{
  "name": "@bkyexam-practice/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:summary": "tsx src/import/loadQuestionBank.ts",
    "import:db": "tsx src/import/importQuestionBank.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:smoke": "tsx src/db/smoke.ts"
  },
  "dependencies": {
    "@bkyexam-practice/shared": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.9.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
